</section>

<style>

    .active_category {
        background-color: var(--cta-background-active);
    }

    .inactive_category {
        background-color: var(--cta-background-inactive);
    }

    .inactive_arrow {
        transform: rotate(90deg);
    }

    .category{
        outline: 2px solid black;
    }

    .category_btn {
        outline: 2px solid black;
        background: var(--category-background);
    }

</style>

