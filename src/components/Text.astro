---
const {
  size = "medium",
  font = "sans",
  weight = "medium",
  stylingclasses = "",
} = Astro.props;

const sizeClasses = {
  medium: "text-[1rem] md:text-[1.125rem] lg:text-[0.938rem]",
  small: "text-[0.875rem] lg:text-[0.625rem]",
};

const fontClasses = {
  sans: "font-sans",
};

const weightClasses = {
  light: "font-light",
  medium: "font-medium",
  bold: "font-bold",
};
---

<p
  class:list={[
    sizeClasses[size],
    fontClasses[font],
    weightClasses[weight],
    stylingclasses,
  ]}
>
  <slot />
</p>
