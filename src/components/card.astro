---
//@ts-nocheck
import Text from './Text.astro';

    // url and key to supabase/database
const url = "https://hrhpfuamvbbfvfhfchbv.supabase.co/rest/v1/NintendoPusheren";
const key =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhyaHBmdWFtdmJiZnZmaGZjaGJ2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3ODA5OTMsImV4cCI6MjA5NTM1Njk5M30.pDuU-_jF2L-ehWC0LVdEd8wuTOJprqtwgGcygfZN-zE";

const options = {
  headers: {
    apikey: key,
  },
};
// fetch data
const response = await fetch(url, options);
const data = await response.json();
const products = Array.isArray(data) ? data : [];

const {product} = Astro.props;

const today = new Date();
today.setHours(0, 0, 0, 0);
const releaseDate = new Date(product.release);
releaseDate.setHours(0, 0, 0, 0);

---


 <div class="w-fit relative">

    {releaseDate > today && product.discount ? (
      <div class="relative">
        <div class="max-w-25 rounded-xl bg-amber-200 min-w-20 absolute left-30 top-0 text-center">
          <p>Pre-Order</p>
        </div>
        <div class="max-w-25 rounded-xl bg-green-200 min-w-20 absolute left-30 top-7 text-center">
          <p>Tilbud</p>
        </div>
      </div>
    ) : (
      <>
        {releaseDate > today &&
        <div class="max-w-25 rounded-xl bg-amber-200 min-w-20 absolute left-30 top-0 text-center">
          <p>Pre-Order</p>
        </div>
        }

        {product.discount &&
        <div class="max-w-25 rounded-xl bg-green-200 min-w-20 absolute left-30 top-0 text-center">
          <p>Tilbud</p>
        </div>
        }

          {product.type == "used" &&
        <div class="max-w-25 rounded-xl bg-black-500 min-w-20 absolute left-30 top-0 text-center">
          <p class="text-white">Brugt</p>
        </div>
        }
      </>
    )}
  
        <a href=`/${product.slug}`>
            <img src={product.img} alt="Image for product" class="place-self-center w-50 max-h-50 object-contain">
            <div class="flex flex-col place-self-center">
            <Text stylingclasses="place-self-center">{product.title}</Text>
            <div class="flex flex-row gap-2 place-self-center">
            {product.discount &&
            <Text stylingclasses="mx-auto opacity-50 line-through" >{product.price},00 kr</Text>
            }
            <Text stylingclasses="mx-auto" >{Math.ceil((product.price - product.price * (product.discount / 100)))},00 kr</Text>
            </div>
          </div>
        </a>
</div>

