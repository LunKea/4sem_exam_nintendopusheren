    </div>

    <section class="grid grid-cols-2 gap-5">
        <div>
            <Text size="xsmall"> Home/ {myProduct?.category}/ {myProduct?.title} </Text>
            <img src={myProduct?.img} alt="product" class="w-full h-auto">
        </div>

        <div class="flex flex-col gap-2">
        <Heading size="large"> {myProduct?.title}</Heading>
