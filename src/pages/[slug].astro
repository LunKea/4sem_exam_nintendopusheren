export async function getStaticPaths() {
    // url and key to supabase/database
const url = "https://hrhpfuamvbbfvfhfchbv.supabase.co/rest/v1/NintendoPusheren";
const key ="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhyaHBmdWFtdmJiZnZmaGZjaGJ2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3ODA5OTMsImV4cCI6MjA5NTM1Njk5M30.pDuU-_jF2L-ehWC0LVdEd8wuTOJprqtwgGcygfZN-zE";

  const options = {
  headers: {
    apikey: key,
  },
};
  const data = await fetch(url, options).then((res) => {
  return res.json();
});



  return data.map((product) => {
    return {
      params: { slug: product.slug},
      props: { myProduct: product },
    };
  });
}

// const { id } = Astro.params;
const { myProduct } = Astro.props;


