---
//@ts-nocheck
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';



export async function getStaticPaths() {
    // url and key to supabase/database
const url1 = "https://hrhpfuamvbbfvfhfchbv.supabase.co/rest/v1/NintendoPusheren";
const url2 = "https://hrhpfuamvbbfvfhfchbv.supabase.co/rest/v1/Switch2";
const key ="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhyaHBmdWFtdmJiZnZmaGZjaGJ2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3ODA5OTMsImV4cCI6MjA5NTM1Njk5M30.pDuU-_jF2L-ehWC0LVdEd8wuTOJprqtwgGcygfZN-zE";

  const options = {
  headers: {
    apikey: key,
  },
};
  const data1 = await fetch(url1, options).then((res) => {
  return res.json();
});

  const data2 = await fetch(url2, options).then((res) => {
  return res.json();
});

  const data = Array.isArray(data1) ? data1 : [];
  const data2Array = Array.isArray(data2) ? data2 : [];
  const allProducts = [...data, ...data2Array];

  return allProducts.map((product) => {
    return {
      params: { slug: product.slug},
      props: { myProduct: product },
    };
  });
}

// const { id } = Astro.params;
const { myProduct } = Astro.props;

const today = new Date();
today.setHours(0, 0, 0, 0);
const releaseDate = new Date(myProduct.release);
releaseDate.setHours(0, 0, 0, 0);
---

<MainLayout title="Titel">
	<section class="mx-10">
    
    <a href="#" onclick="history.back()">
    <div class="flex flex-row my-5">
    <img src="/icons/arrow_up.svg" alt="Image for category" class="w-10 h-auto rotate-270">
     <Text>Tilbage</Text>
    </div>
    </a>

    <section class="grid grid-cols-2 gap-5">
        <div>
          {releaseDate > today && myProduct.discount ? (
      <div class="relative">
        <div class="max-w-25 rounded-xl bg-amber-200 min-w-20 absolute place-self-end top-0 text-center">
          <p>Pre-Order</p>
        </div>
        <div class="max-w-25 rounded-xl bg-green-200 min-w-20 absolute place-self-end top-7 text-center">
          <p>Tilbud</p>
        </div>
      </div>
    ) : (
      <>
      <div class="relative">
        {releaseDate > today &&
        <div class="max-w-25 rounded-xl bg-amber-200 min-w-20 absolute place-self-end top-0 text-center">
          <p>Pre-Order</p>
        </div>
        }

        {myProduct.discount &&
        <div class="max-w-25 rounded-xl bg-green-200 min-w-20 absolute place-self-end top-0 text-center">
          <p>Tilbud</p>
        </div>
        }

          {myProduct.type == "used" &&
        <div class="max-w-25 rounded-xl bg-black-500 min-w-20 absolute place-self-end top-0 text-center">
          <p class="text-white">Brugt</p>
        </div>
        }
        </div>
      </>
    )}
            <Text size="xsmall"> Home/ {myProduct?.category}/ {myProduct?.title} </Text>
            <img src={myProduct?.img} alt="product" class="w-full h-auto">
        </div>

        <div class="flex flex-col gap-2">
        <Heading size="large"> {myProduct?.title}</Heading>
        <Text>Kategori: {myProduct?.category}</Text>
      
        {myProduct.discount &&
        <Heading stylingclasses="opacity-50 line-through" >{myProduct.price},00 kr</Heading>
            }
        <Heading >{Math.ceil((myProduct.price - myProduct.price * (myProduct.discount / 100)))},00 kr</Heading>
        
        <div class="h-90">
        <Text stylingclasses="whitespace-pre-line">{myProduct?.desc}</Text>
        </div>

        <div class="flex flex-row justify-between">
            <div class="w-20 h-10 bg-green-800">
            </div>

            <div class="w-20 h-10 bg-green-800">
            </div>

            <div class="w-20 h-10 bg-green-800">
            </div>

            <div class="w-20 h-10 bg-green-800">
            </div>

        </div>

        </div>
    </section>

    


    </section>
</MainLayout>